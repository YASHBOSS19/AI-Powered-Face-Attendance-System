DB_HOST=your_production_db_host
DB_USER=your_production_db_user
DB_PASSWORD=your_production_db_password
DB_NAME=attendance_db
DB_PORT=3306

# Cloudflare R2 Settings for Logo Upload
# Set these to actual values in production. Leave empty to fallback to local storage.
R2_ACCOUNT_ID=your_production_account_id
R2_ACCESS_KEY_ID=your_production_access_key
R2_SECRET_ACCESS_KEY=your_production_secret_key
R2_BUCKET_NAME=your_production_bucket
R2_PUBLIC_URL=your_production_public_url
